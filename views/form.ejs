<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/styles.css">
        <link rel="icon" type="image.png" href="/logo_owl.png">
        <title>Owl Message Board</title>
    </head>

    <body>
        <div>
            <form method="POST" action="/new">
                <label for="mess">Message:
                    <input type="text" name="messageText" id="mess" />
                </label>
                <label for="user">Username:
                    <input type="text" name="messageUser" id="user" /> 
                </label>
                <button type="submit">
                    Send
                </button>
            </form>
        </div>
    </body>
</html>
